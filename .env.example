# =====================================================================
# Required — the app will not start without these
# =====================================================================
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=

# PostgreSQL (shared by Django, listener, and ingestion)
DB_NAME=
DB_USER=
DB_PASSWORD=

# SMTP (Gmail)
SMTP_USER=
SMTP_PASSWORD=

# Gmail API (optional — used when outbound SMTP is blocked, e.g. a restricted
# server firewall. When these three are set, event emails are sent via the
# Gmail API over HTTPS instead of SMTP. Generate them with scripts/get_gmail_token.py).
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
# GMAIL_SENDER_EMAIL=<defaults to SMTP_USER; must be the account that owns the refresh token>

# MQTT (WIS2 Global Broker)
MQTT_BROKER_HOST=
MQTT_BROKER_PORT=
MQTT_TRANSPORT=
MQTT_WEBSOCKET_PATH=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=

# Jira (optional — the Create Jira Ticket button is disabled when unset)
JIRA_URL=
JIRA_PROJECT_KEY=
JIRA_API_TOKEN=
# JIRA_ISSUE_TYPE=Incident
# Optional custom field (e.g. country). Only sent when JIRA_COUNTRY_FIELD_ID is set.
# JIRA_COUNTRY_FIELD_ID=
# JIRA_COUNTRY_FIELD_VALUE=morocco

# Ollama (optional — powers the conversational "Explain Event" button on the
# event detail page, backed by a local Ollama server. When both are unset the
# button is disabled. OLLAMA_HOST accepts an optional http:// prefix and a
# custom read timeout in seconds.)
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:3b-instruct
# OLLAMA_TIMEOUT=300

# =====================================================================
# Optional — these have sensible defaults
# =====================================================================
# DJANGO_DEBUG=False
# DB_HOST=localhost
# DB_PORT=5432
# SMTP_FROM=<defaults to SMTP_USER>
# EMAIL_TIMEOUT=15
