# =====================================================================
# Required — the app will not start without these
# =====================================================================
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=

# PostgreSQL (shared by Django, listener, and ingestion)
DB_NAME=
DB_USER=
DB_PASSWORD=

# Ingestion uses a separate PostgreSQL user
INGEST_DB_USER=
INGEST_DB_PASSWORD=

# SMTP (Gmail)
SMTP_USER=
SMTP_PASSWORD=

# MQTT (WIS2 Global Broker)
MQTT_BROKER_HOST=
MQTT_BROKER_PORT=
MQTT_TRANSPORT=
MQTT_WEBSOCKET_PATH=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=

# =====================================================================
# Optional — these have sensible defaults
# =====================================================================
# DJANGO_DEBUG=False
# DB_HOST=localhost
# DB_PORT=5432
# SMTP_FROM=<defaults to SMTP_USER>
